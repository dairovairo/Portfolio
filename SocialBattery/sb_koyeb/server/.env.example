SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
PORT=3001
CLIENT_URL=http://localhost:5173

# ── Web Push (notificaciones móviles) ─────────────────────────────────────────
# Genera tu par de claves con:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k);"
# Luego pon VAPID_PUBLIC_KEY también en client/src/hooks/usePush.js (applicationServerKey)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── FCM (notificaciones en Android/iOS con la app en 2º plano o cerrada) ──────
# Web Push (arriba) no llega de forma fiable al WebView de Android con la app
# cerrada; para eso hace falta Firebase Cloud Messaging.
#
# 1. Crea un proyecto en https://console.firebase.google.com (o reutiliza uno)
# 2. Añade una app Android con el package name com.socialbattery.app
#    (debe coincidir con mobile/capacitor.config.json → appId)
# 3. Descarga google-services.json y colócalo en mobile/android/app/google-services.json
# 4. Project settings → Service accounts → Generate new private key
#    → pega el JSON entero (una sola línea) en FIREBASE_SERVICE_ACCOUNT_JSON,
#    o en base64 en FIREBASE_SERVICE_ACCOUNT_BASE64 si tu plataforma de
#    despliegue no admite bien JSON multilínea/con comillas en variables de entorno:
#      node -e "console.log(require('fs').readFileSync('serviceAccount.json').toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
