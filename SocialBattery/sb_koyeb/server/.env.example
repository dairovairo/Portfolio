SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
PORT=3001
CLIENT_URL=http://localhost:5173

# ── Web Push (notificaciones navegador / PWA) ─────────────────────────────────
# Genera tu par de claves con:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k);"
# Luego pon VAPID_PUBLIC_KEY también en client/src/hooks/usePush.js (applicationServerKey)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Firebase Cloud Messaging (push nativo Android/iOS con app cerrada) ────────
# Necesario para las notificaciones push del wrapper Capacitor. Sácalo del JSON
# del "service account" (Firebase Console → Project settings → Service accounts
# → Generate new private key).
#
# OJO con FIREBASE_PRIVATE_KEY: mantén los '\n' literales tal cual salen del
# JSON, no los reemplaces por saltos reales. El código de server/lib/fcm.js los
# convierte automáticamente antes de pasárselos a firebase-admin.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
