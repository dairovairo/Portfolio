SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
PORT=3001
CLIENT_URL=http://localhost:5173

# ── Web Push (notificaciones navegador / PWA) ─────────────────────────────────
# Genera tu par de claves con:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k);"
# Luego pon VAPID_PUBLIC_KEY también en client/src/hooks/usePush.js (applicationServerKey)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Firebase Cloud Messaging (push nativo Android/iOS con app cerrada) ────────
# Necesario para las notificaciones push del wrapper Capacitor. Sácalo del JSON
# del "service account" (Firebase Console → Project settings → Service accounts
# → Generate new private key).
#
# OJO con FIREBASE_PRIVATE_KEY: mantén los '\n' literales tal cual salen del
# JSON, no los reemplaces por saltos reales. El código de server/lib/fcm.js los
# convierte automáticamente antes de pasárselos a firebase-admin.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Pagos (ver PAGOS_SETUP.md) ───────────────────────────────────────────────
# Interruptor general: mientras no sea 'true' las campañas se crean gratis
# (no se reserva ni cobra saldo). Actívalo DESPUÉS de ejecutar la migración
# phase134 y configurar al menos un proveedor.
PAYMENTS_ENABLED=false
# URL pública del frontend (vuelta de Stripe Checkout). Si falta, se usa el
# primer valor de CLIENT_URL.
PUBLIC_APP_URL=https://socialbattery.pro
# Stripe (web): Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Google Play (app Android). Si faltan EMAIL/KEY se reutilizan las FIREBASE_*
GOOGLE_PLAY_PACKAGE_NAME=com.socialbattery.app
# GOOGLE_PLAY_CLIENT_EMAIL=play-billing@tu-proyecto.iam.gserviceaccount.com
# GOOGLE_PLAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
